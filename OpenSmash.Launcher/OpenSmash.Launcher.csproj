<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>false</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>..\media\opensmash.ico</ApplicationIcon>
    <AssemblyName>OpenSmash</AssemblyName>
    <RootNamespace>OpenSmash.Launcher</RootNamespace>
    <!-- (v0.5.0) the release workflow builds with -p:Version=X.Y.Z; a local build is 0.0.0-dev (older than any
         release: OpenSmash.Core.Updater compares it with the release channel's) -->
    <Version Condition="'$(Version)' == '' or '$(Version)' == '1.0.0'">0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>OpenSmash-Ultimate</Product>
    <Description>Super Smash Bros. Ultimate native PC port launcher</Description>
    <Copyright>GPL-3.0</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\locales\*.json" LogicalName="Locales.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\media\opensmash.ico" LogicalName="opensmash.ico" />
    <!-- Mod browser UI: kept as a real HTML file so the markup/JS is plain
         UTF-8 instead of an escaped C# string literal. -->
    <EmbeddedResource Include="UiLocale.Web.js" LogicalName="UiLocale.Web.js" />
    <EmbeddedResource Include="MarketplaceHtml.html" LogicalName="MarketplaceHtml.html" />
    <!-- The site's display face (SIL OFL, Assets\Anton-OFL.txt) and its white emblem. -->
    <EmbeddedResource Include="Assets\Anton-Regular.ttf" LogicalName="Anton-Regular.ttf" />
    <EmbeddedResource Include="Assets\emblem-white.png" LogicalName="emblem.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSmash.Core\OpenSmash.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>